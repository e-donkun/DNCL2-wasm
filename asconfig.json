{
  "targets": {
    "debug": {
      "outFile": "build/dncl.debug.wasm",
      "textFile": "build/dncl.debug.wat",
      "sourceMap": true,
      "debug": true,
      "exportRuntime": true
    },
    "release": {
      "outFile": "build/dncl.wasm",
      "exportRuntime": true,
      "optimizeLevel": 3,
      "shrinkLevel": 1,
      "converge": false,
      "noAssert": false
    }
  },
  "options": {
    "bindings": "esm"
  }
}
